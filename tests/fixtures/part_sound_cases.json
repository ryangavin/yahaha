{
  "_about": "What a keyboard part plays, named: cases both api::part_sound (src/api/parts.rs) and partSound (app/src/lib/api/part-sound.ts) must agree on. The library in both tests: patches grand (SoundFont 'Stage Grand'), warm (factory plugin 'Warm Keys'), mine (user plugin 'My Keys'); the GM map sends program 1 to grand and 2 to mine; the auto-fill covers programs 0-9 on A.sf2, named 'A<n>'. The plugin is 'aumu Smp7 Fake', named 'Sampler Deluxe'. voice null means the GM name of the program.",
  "cases": [
    { "name": "preset, no library record", "of": { "plugin": { "status": "playing", "preset": ["f:3", "Warm Keys"] }, "program": 7 }, "want": ["au:aumu Smp7 Fake#f:3", "Warm Keys", "Sampler Deluxe · Warm Keys"] },
    { "name": "preset, its own factory record", "of": { "plugin": { "status": "playing", "preset": ["f:3", "Warm Keys"] }, "pluginSound": { "id": "saved:warm", "name": "Warm Keys" }, "program": 7 }, "want": ["au:aumu Smp7 Fake#f:3", "Warm Keys", "Sampler Deluxe · Warm Keys"] },
    { "name": "a sound the user saved, named now", "of": { "plugin": { "status": "playing", "preset": ["f:3", "Warm Keys"] }, "pluginSound": { "id": "saved:mine", "name": "Old name" }, "program": 7 }, "want": ["saved:mine", "My Keys", "My Keys"] },
    { "name": "a factory preset's sound, no preset", "of": { "plugin": { "status": "playing", "preset": null }, "pluginSound": { "id": "saved:warm", "name": "Warm Keys" }, "program": 7 }, "want": ["saved:warm", "Warm Keys", "Sampler Deluxe · Warm Keys"] },
    { "name": "a deleted sound", "of": { "plugin": { "status": "playing", "preset": null }, "pluginSound": { "id": "saved:gone", "name": "Gone" }, "program": 7 }, "want": ["au:aumu Smp7 Fake", "Sampler Deluxe", "Sampler Deluxe"] },
    { "name": "bare plugin", "of": { "plugin": { "status": "playing", "preset": null }, "program": 7 }, "want": ["au:aumu Smp7 Fake", "Sampler Deluxe", "Sampler Deluxe"] },
    { "name": "muted keeps the name", "of": { "plugin": { "status": "muted", "preset": ["f:3", "Warm Keys"] }, "program": 7 }, "want": ["au:aumu Smp7 Fake#f:3", "Warm Keys", "Sampler Deluxe · Warm Keys"] },
    { "name": "loading keeps the name", "of": { "plugin": { "status": "loading", "preset": ["f:3", "Warm Keys"] }, "program": 7 }, "want": ["au:aumu Smp7 Fake#f:3", "Warm Keys", "Sampler Deluxe · Warm Keys"] },
    { "name": "auto-fill", "of": { "program": 7 }, "want": ["sf:A.sf2:0:7", "A7", "A7"] },
    { "name": "a map rule", "of": { "program": 1 }, "want": ["saved:grand", "Stage Grand", "Stage Grand"] },
    { "name": "its own SoundFont patch", "of": { "own": "grand", "program": 7 }, "want": ["saved:grand", "Stage Grand", "Stage Grand"] },
    { "name": "a failed plugin plays the SoundFont voice", "of": { "plugin": { "status": "failed", "preset": ["f:3", "Warm Keys"] }, "pluginSound": { "id": "saved:warm", "name": "Warm Keys" }, "own": "warm", "program": 7 }, "want": ["sf:A.sf2:0:7", "A7", "A7"] },
    { "name": "nothing covers it", "of": { "program": 40 }, "want": [null, null, null] },
    { "name": "a plugin sound no plugin plays", "of": { "program": 2 }, "want": [null, null, null] }
  ]
}
